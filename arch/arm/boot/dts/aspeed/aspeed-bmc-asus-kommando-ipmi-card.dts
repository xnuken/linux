/dts-v1/;

#include "aspeed-g6.dtsi"
#include "aspeed-g6-pinctrl.dtsi"
#include <dt-bindings/gpio/aspeed-gpio.h>
#include <dt-bindings/clock/ast2600-clock.h>
#include <dt-bindings/interrupt-controller/aspeed-scu-ic.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>

/ {
	model = "Asus Kommando IPMI Expansion Card";
	compatible = "asus,ast2600-kommando-ipmi-card", "aspeed,ast2600";

	aliases {
		serial4 = &uart5;
	};

	chosen {
		stdout-path = "serial4:115200n8";
	};

	leds {
		compatible = "gpio-leds";

		led-fault {
			gpios = <&gpio1 ASPEED_GPIO(C, 5) GPIO_ACTIVE_HIGH>;
			label = "panic_amber";
			panic-indicator;
			default-state = "off";
		};

		led-heartbeat {
			gpios = <&gpio0 ASPEED_GPIO(A, 7) GPIO_ACTIVE_LOW>;
			label = "heartbeat_green";
			linux,default-trigger = "timer";
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x40000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		video_engine_memory: video {
			size = <0x04000000>;
			alignment = <0x01000000>;
			compatible = "shared-dma-pool";
			reusable;
		};
	};

	iio-hwmon {
		compatible = "iio-hwmon";
		io-channels = <&adc0 0>, <&adc0 1>, <&adc0 2>, <&adc0 3>,
			      <&adc0 4>, <&adc0 5>, <&adc0 6>, <&adc0 7>,
			      <&adc1 0>, <&adc1 1>, <&adc1 2>, <&adc1 3>,
			      <&adc1 4>, <&adc1 5>, <&adc1 6>, <&adc1 7>;
	};
};

&fmc {
	status = "okay";

	flash@0 {
		status = "okay";
		m25p,fast-read;
		label = "bmc";
		spi-max-frequency = <50000000>;
#include "openbmc-flash-layout-64.dtsi"
	};
};

&spi1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_spi1_default>;

	flash@0 {
		status = "okay";
		m25p,fast-read;
		label = "pnor";
		spi-max-frequency = <50000000>;
	};
};

&emmc {
	status = "okay";
	bus-width = <4>;
	max-frequency = <100000000>;
	sdhci-drive-type = [03];
};

&emmc_controller {
	status = "okay";
};

&sdc {
	status = "okay";
};

&sdhci0 {
	status = "okay";
	bus-width = <4>;
	max-frequency = <100000000>;
	sdhci-caps-mask = <0x07 0x580000>;
	sdhci,auto-cmd12;
	sdhci,wp-inverted;
};

&mdio2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_mdio3_default>;
	#address-cells = <1>;
	#size-cells = <0>;

	ethphy2: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
	};
};

&mac2 {
	status = "okay";
	/* Bootloader sets up the MAC to insert delay */
	phy-mode = "rgmii";
	phy-handle = <&ethphy2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_rgmii3_default>;
};

&vhub {
	status = "okay";
};

&video {
	status = "okay";
	memory-region = <&video_engine_memory>;
};

&rtc {
	status = "okay";
};

&fsim0 {
	status = "okay";
};

&peci0 {
	status = "okay";
};

&lpc_ctrl {
	status = "okay";
};

&lpc_snoop {
	status = "okay";
	snoop-ports = <0x80>;
};

&vuart3 {
	status = "okay";
};

&adc0 {
	vref = <2500>;
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_adc0_default &pinctrl_adc1_default
		     &pinctrl_adc2_default &pinctrl_adc3_default
		     &pinctrl_adc4_default &pinctrl_adc5_default
		     &pinctrl_adc6_default &pinctrl_adc7_default>;
};

&adc1 {
	vref = <2500>;
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_adc8_default &pinctrl_adc9_default
		     &pinctrl_adc10_default &pinctrl_adc11_default
		     &pinctrl_adc12_default &pinctrl_adc13_default
		     &pinctrl_adc14_default &pinctrl_adc15_default>;
};

&i2c0 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&i2c3 {
	status = "okay";
};

&i2c5 {
	status = "okay";
};

&i2c6 {
	status = "okay";
};

&i2c7 {
	status = "okay";
};

&kcs1 {
	status = "okay";
	aspeed,lpc-io-reg = <0xca0>;
};

&kcs2 {
	status = "okay";
	aspeed,lpc-io-reg = <0xca8>;
};

&wdt1 {
	status = "okay";
};

&wdt2 {
	status = "okay";
};

&pwm_tach {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pwm0_default &pinctrl_pwm1_default>;

	fan@0 {
		aspeed,fan-tach-ch = [00];
		cooling-levels = [7d 97 b1 cb e5 ff];
		period;
		reg = <0x00>;
	};

	fan@1 {
		aspeed,fan-tach-ch = [01];
		cooling-levels = [7d 97 b1 cb e5 ff];
		reg = <0x01>;
	};

	fan@2 {
		aspeed,fan-tach-ch = [02];
		cooling-levels = [7d 97 b1 cb e5 ff];
		reg = <0x02>;
	};

	fan@3 {
		aspeed,fan-tach-ch = [03];
		cooling-levels = [7d 97 b1 cb e5 ff];
		reg = <0x03>;
	};

	fan@4 {
		aspeed,fan-tach-ch = [04];
		cooling-levels = [7d 97 b1 cb e5 ff];
		reg = <0x04>;
	};

	fan@5 {
		aspeed,fan-tach-ch = [05];
		cooling-levels = [7d 97 b1 cb e5 ff];
		reg = <0x05>;
	};

	fan@6 {
		aspeed,fan-tach-ch = [06];
		cooling-levels = [7d 97 b1 cb e5 ff];
		reg = <0x06>;
	};

	fan@7 {
		aspeed,fan-tach-ch = [07];
		cooling-levels = [7d 97 b1 cb e5 ff];
		reg = <0x07>;
	};
};

&gpio0 {
	status = "okay";
	gpio-line-names =
			  /*A0 0*/ "", "", "", "", "", "BMC_CS_CTRLI", "", "BMC_HBLED",
			  /*B0 8*/ "", "BMC_FW_EN", "BMC_HD_DETECT", "MLED_SEL", "BMCLED_SEL", "BMC_DEEPS5", "MB_S5_DETECT", "BMC_SPI_CTRLI",
			  /*C0 16*/ "", "", "", "", "", "", "", "",
			  /*D0 24*/ "", "", "", "", "", "", "", "",
			  /*E0 32*/ "", "", "", "", "", "", "", "",
			  /*F0 40*/ "", "", "", "", "BMC_UPDATEBIOS", "+3VSB", "", "",
			  /*G0 48*/ "BMC_CHAFAN1_MODE", "BMC_CHAFAN2_MODE", "BMC_CHAFAN3_MODE", "BMC_CHAFAN4_MODE", "BMC_CHAFAN5_MODE", "BMC_CHAFAN6_MODE", "BMC_CHAFAN7_MODE", "BMC_CHAFAN8_MODE",
			  /*H0 56*/ "", "", "", "", "", "", "BMC_PHY_LINK", "",
			  /*I0 64*/ "", "", "", "BMC_RSTBTN", "", "", "", "",
			  /*J0 72*/ "", "", "", "", "", "", "", "",
			  /*K0 80*/ "I2C_5_SCL", "I2C_5_SDA", "", "", "", "", "", "",
			  /*L0 88*/ "", "", "", "", "", "", "", "",
			  /*M0 96*/ "S_RTCRST_CTRL", "O_BMC_ERP_10", "O_SEL_3.3V_1.8V_10", "S_SLPS3", "BMC_PERST_R", "SPIPWR_EN", "BMC_VGA_SW", "",
			  /*N0 104*/ "CF_FTI_AUX0", "CF_FTI_AUX1", "CF_FTI_AUX2", "CF_FTI_AUX3", "CF_FTI_AUX4", "CF_FTI_AUX5", "CF_FTI_AUX6", "CF_FTI_AUX7",
			  /*O0 112*/ "", "", "", "", "", "", "", "",
			  /*P0 120*/ "", "", "", "", "", "", "", "",
			  /*Q0 128*/ "", "", "", "", "", "", "", "",
			  /*R0 136*/ "", "", "", "+12V_DETECT", "", "", "AUX_BMCLOCBTN_R", "",
			  /*S0 144*/ "", "", "", "", "", "", "", "",
			  /*T0 152*/ "", "", "", "", "", "", "", "",
			  /*U0 160*/ "", "", "", "", "", "", "", "",
			  /*V0 168*/ "", "", "", "", "BMC_PWRBTN", "", "MB_S0_DETECT", "",
			  /*W0 176*/ "", "", "", "", "", "", "", "",
			  /*X0 184*/ "", "BMC_INIT", "BMC_READY", "", "", "", "BMC_HWMSW", "",
			  /*Y0 192*/ "", "", "BMC_RESETDIS", "", "", "", "BMC_PSONEN", "BMC_PRESENT",
			  /*Z0 200*/ "", "", "BMC_PWRBTNDIS", "", "", "", "", "";
};

&gpio1 {
	status = "okay";
	gpio-line-names =
			  /*18A0 0*/ "", "", "", "", "DMLAN_IP_SEL", "", "", "GPIO18A7",
			  /*18B0 8*/ "GPIO18B0", "", "", "", "", "", "", "",
			  /*18C0 16*/ "", "", "", "", "", "BMC_MLED", "", "",
			  /*18D0 24*/ "", "", "", "", "", "", "", "",
			  /*18E0 32*/ "", "", "", "", "", "", "", "";
};
